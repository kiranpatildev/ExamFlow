# ============================================================
#  ExamFlow — .gitignore
# ============================================================

# ── Python / Django ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.manifest
*.spec

# Virtual environment
backend/venv/
backend/env/
backend/.venv/
venv/
env/
.venv/

# Django secrets & config
backend/.env
backend/local_settings.py

# Django collected static
backend/staticfiles/
backend/static/

# Django media uploads (answer sheet images & PDFs)
backend/media/

# Django migrations (keep these in version control — comment out if needed)
# backend/apps/*/migrations/

# Database
*.sqlite3
*.db

# Coverage
.coverage
htmlcov/
.pytest_cache/

# MyPy
.mypy_cache/
.dmypy.json

# ── Node / React / Vite ──────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Vite cache
frontend/.vite/

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.DS_Store
Thumbs.db

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
build_errors.txt
